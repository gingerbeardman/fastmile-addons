# Copy to credentials.local (git-ignored) and fill in. Never commit the copy.
# Load into a shell with:  set -a; . ./credentials.local; set +a

# Gateway web UI (client/fm.py; also read as FM_HOST / FM_USER / NOKIA)
FM_WEB_URL=
FM_WEB_USER=
FM_WEB_PASS=

# xbar plugin (client/xbar/agvpn.30s.py). FM_PASS overrides the Keychain item
# "fastmile-router"; AGVPN_TOKEN overrides the Keychain item "fastmile-agvpn-token".
FM_HOST=
FM_USER=
FM_PASS=
AGVPN_TOKEN=

# Root ssh target for client/fmbackup.py (FM_SSH, or FM_SSH_USER + host/port)
FM_SSH=
FM_SSH_USER=
FM_SSH_HOST=
FM_SSH_PORT=

# AdGuard VPN, IPsec mode (device/make-ipsec-secret.sh). The username and
# password from the AdGuard VPN dashboard's router/IPsec settings.
AGVPN_USER=
AGVPN_PASS=
# Your IPsec server hostnames, for reference when filling in
# device/agvpn/ipsec-servers (see device/agvpn/ipsec-servers.example).
AGVPN_SERVERS=

# Mock server (server/mockd.py, server/harness.mjs)
MOCK_USER=
MOCK_PW=
MOCK_PORT=
MOCK_TTL=

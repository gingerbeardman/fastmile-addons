#!/bin/sh /etc/rc.common
# AdGuard VPN supervisor. Settings: /data/adguardvpn-cli/agvpn.conf
START=99
STOP=10
USE_PROCD=1

start_service() {
	. /data/adguardvpn-cli/agvpn.conf 2>/dev/null
	[ "$ENABLED" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/agvpn run
	procd_set_param respawn 3600 10 0
	procd_set_param term_timeout 15
	procd_close_instance
}

stop_service() {
	/usr/sbin/agvpn teardown
}
